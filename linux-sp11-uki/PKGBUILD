# Maintainer: Dale Whinham <daleyo@gmail.com>

pkgname=linux-sp11-uki
pkgver=1
pkgrel=2
pkgdesc='Unified kernel images for the Surface Pro 11'
arch=('any')
url='https://github.com/dwhinham/archlinux-repo'
license=('BSD-3-Clause')
groups=('sp11')
depends=('linux-sp11' 'linux-sp11-dtbs' 'systemd-ukify' 'mkinitcpio' 'jq')
install=linux-sp11-uki.install
source=('linux-sp11-mkuki'
        '95-linux-sp11-uki.hook'
        'linux-sp11-fallback-modules.service')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
	install -Dm755 linux-sp11-mkuki "$pkgdir/usr/bin/linux-sp11-mkuki"
	install -Dm644 95-linux-sp11-uki.hook \
		"$pkgdir/usr/share/libalpm/hooks/95-linux-sp11-uki.hook"
	install -Dm644 linux-sp11-fallback-modules.service \
		"$pkgdir/usr/lib/systemd/system/linux-sp11-fallback-modules.service"
}

# linux-sp11-uki 1-2 shipped linux-sp11-fallback-modules.service, whose ordering deadlocked boot
# (udev coldplug waited for it, it waited for local-fs, local-fs waited for coldplug). It is gone;
# remove what it left behind: the enable link and the mask placed during recovery.
post_upgrade() {
	rm -f /etc/systemd/system/sysinit.target.wants/linux-sp11-fallback-modules.service
	[[ $(readlink /etc/systemd/system/linux-sp11-fallback-modules.service) == /dev/null ]] &&
		rm -f /etc/systemd/system/linux-sp11-fallback-modules.service
	systemctl daemon-reload 2>/dev/null || true
	echo ":: Rebuild the initramfs for the Type Cover drivers: mkinitcpio -P && linux-sp11-mkuki"
}

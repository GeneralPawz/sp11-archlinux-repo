# Booting the fallback kernel image: its modules were moved to /usr/lib/modules/.old by
# kernel-modules-hook's cleanup after the newer kernel booted. Put them back before udev and
# modules-load need them, so the fallback boots with Wi-Fi, sound and the rest, not just a console.
[Unit]
Description=Restore kernel modules for a fallback kernel image
DefaultDependencies=no
After=local-fs.target
Before=systemd-udev-trigger.service systemd-modules-load.service sysinit.target
ConditionPathExists=!/usr/lib/modules/%v
ConditionPathExists=/usr/lib/modules/.old/%v

[Service]
Type=oneshot
ExecStart=/usr/bin/cp -a /usr/lib/modules/.old/%v /usr/lib/modules/%v
ExecStart=/usr/bin/depmod %v

[Install]
WantedBy=sysinit.target

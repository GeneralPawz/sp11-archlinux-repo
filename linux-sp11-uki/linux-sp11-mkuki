#!/bin/bash
# Builds one unified kernel image per Surface Pro 11 variant.

set -euo pipefail

pkgbase=linux-sp11
esp=/boot
variants=(
	'oled:qcom/x1e80100-microsoft-denali-oled.dtb'
	'lcd:qcom/x1p64100-microsoft-denali.dtb'
)

# Ask pacman which kernel the package installed. Globbing for */pkgbase is
# not enough: kernel-modules-hook keeps the running kernel's module directory
# (pkgbase included) across an upgrade, and glob order is locale dependent,
# so the old kernel could be picked and paired with the new initramfs.
kver=$(pacman -Qlq "$pkgbase" 2>/dev/null |
	sed -n 's|^/usr/lib/modules/\([^/]*\)/pkgbase$|\1|p') || kver=
[[ -n $kver ]] || { echo "$pkgbase is not installed, nothing to build" >&2; exit 0; }

initrd="$esp/initramfs-$pkgbase.img"
[[ -e $initrd ]] || { echo "no initramfs at $initrd, has mkinitcpio run?" >&2; exit 1; }
# Exit 0, not 1: this runs as a pacman hook, and a system with no
# /etc/kernel/cmdline has no unified kernel images to keep up to date.
# Failing here would abort the transaction that installed this package.
[[ -r /etc/kernel/cmdline ]] || { echo "no /etc/kernel/cmdline, nothing to build" >&2; exit 0; }

contents=$(lsinitcpio -l "$initrd")

# The initramfs must belong to the kernel going into the image: a kernel booted with another
# kernel's initramfs cannot load any module and comes up without display or keyboard.
if ! grep -q "^usr/lib/modules/$kver/" <<<"$contents"; then
	echo "ERROR: $initrd was not built for $kver; keeping the existing kernel images." >&2
	echo "Run mkinitcpio -P, then $0." >&2
	exit 1
fi

# The internal panel has to come up from the initramfs: an image built without the display driver
# boots to a black screen with no way to see or fix anything. Refuse to replace working images then.
for m in msm panel-edp; do
	grep -q "/$m\.ko" <<<"$contents" && continue
	echo "ERROR: $initrd has no $m module; keeping the existing kernel images." >&2
	echo "Run mkinitcpio -P with the display driver loaded, then $0." >&2
	exit 1
done

# The Type Cover keyboard is what makes an emergency shell usable (sp11-rescue-input.conf).
for m in surface_aggregator surface_hid; do
	grep -q "/$m\.ko" <<<"$contents" ||
		echo "WARNING: $initrd has no $m module: no Type Cover in an emergency shell." >&2
done

install -d "$esp/EFI/Linux"

# uname of an existing image, empty if it has none or cannot be read
image_kver() {
	ukify --json=short inspect "$1" 2>/dev/null | jq -r '.".uname".text // empty' 2>/dev/null || true
}

for variant in "${variants[@]}"; do
	name=${variant%%:*}
	dtb="/usr/lib/modules/$kver/dtb/${variant#*:}"
	[[ -e $dtb ]] || { echo "skipping $name: no $dtb" >&2; continue; }

	# Distinguishes the two entries in the boot menu, which is the only way
	# to choose between the panel variants.
	osrel=$(printf 'ID=arch\nPRETTY_NAME=Arch Linux (Surface Pro 11, %s)\nVERSION_ID=%s\n' "$name" "$kver")

	# Keep the image this system is running from as a fallback boot entry, so a kernel that does
	# not come up can be skipped from the boot menu. Only a booted image becomes the fallback, so
	# two broken builds in a row can never push out the last good one.
	out="$esp/EFI/Linux/$pkgbase-$name.efi"
	if [[ -e $out && $(image_kver "$out") == "$(uname -r)" && $kver != "$(uname -r)" ]]; then
		echo "Keeping the running image as $pkgbase-$name-fallback.efi ($(uname -r))"
		cp -f "$out" "$esp/EFI/Linux/$pkgbase-$name-fallback.efi"
	fi

	echo "Building $pkgbase-$name.efi ($kver)"
	ukify build \
		--uname="$kver" \
		--linux="/usr/lib/modules/$kver/vmlinuz" \
		--initrd="$initrd" \
		--cmdline=@/etc/kernel/cmdline \
		--os-release="$osrel" \
		--devicetree="$dtb" \
		--output="$out"
done

# Check what was written: every image must carry the kernel pacman installed. An image that
# silently paired the wrong kernel with this initramfs is how 7.2.8-arch1-3.2 failed to boot.
failed=0
for variant in "${variants[@]}"; do
	out="$esp/EFI/Linux/$pkgbase-${variant%%:*}.efi"
	[[ -e $out ]] || continue
	got=$(image_kver "$out")
	if [[ $got != "$kver" ]]; then
		echo "ERROR: $out carries kernel '${got:-unknown}', expected $kver" >&2
		failed=1
	fi
done
exit $failed
